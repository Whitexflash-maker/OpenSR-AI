<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.superscale.UpscaleView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- result viewer overlay -->
    <ImageView
        android:id="@+id/imgResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:contentDescription="@string/btn_upscale"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvBusy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:padding="20dp"
        android:text="@string/processing"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/panel"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:text="-- fps  |  internal --x--" />

        <Button
            android:id="@+id/btnMode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/mode_smart" />

        <TextView
            android:id="@+id/tvScaleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/label_resolution"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="75"
            android:progress="25" />

        <TextView
            android:id="@+id/tvSharpLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_sharpness"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekSharp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="35" />

        <Button
            android:id="@+id/btnUpscale"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/btn_upscale" />
    </LinearLayout>
</FrameLayout>
